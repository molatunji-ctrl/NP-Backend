# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nuges_pharmacy
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Use a random value containing at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin JSON should be configured in the deployment platform, not committed.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Deployed frontends
APP_FRONTEND_CUSTOMER_URL=https://nugues-phramacy-green.vercel.app
APP_FRONTEND_ADMIN_URL=https://np-admin-one.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://nugues-phramacy-green.vercel.app,https://np-admin-one.vercel.app

# Cross-site HTTPS cookie settings for Vercel -> Render.
AUTH_COOKIE_NAME=jwt
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
AUTH_COOKIE_MAX_AGE_SECONDS=604800

# Checkout and Flutterwave (keep secret values only on the backend host)
CHECKOUT_SHIPPING_COST=1500
CHECKOUT_VAT_RATE=0.075
CHECKOUT_CURRENCY=NGN
CHECKOUT_PAYMENT_EXPIRY_MINUTES=30
CHECKOUT_RESERVATION_GRACE_MINUTES=10
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_MAX_RETRY_ATTEMPTS=3
